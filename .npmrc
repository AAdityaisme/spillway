# npm-style flat node_modules. Most tool-compatible (eslint, tailwind, esbuild
# resolve their own nested sub-deps) AND lets the compiled server + the Fly
# runtime image resolve deps from the top-level node_modules
# (`node dist/apps/server/src/index.js`). shamefully-hoist broke eslint/tailwind
# sub-dependency resolution, so we use the proper hoisted linker instead.
node-linker=hoisted
auto-install-peers=true
# npm-CLI mirror (days, npm ≥11.10) of minimumReleaseAge in pnpm-workspace.yaml (minutes).
# pnpm ignores this key; it covers anyone running plain `npm install` against this tree.
min-release-age=7
