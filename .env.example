# .env.example  —  copy to .env, fill in values, NEVER commit .env

# ─── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development               # development | test | production
PORT=3000                          # Fastify listen port
LOG_LEVEL=info                     # pino: trace|debug|info|warn|error|fatal

# ─── Database (app role — non-superuser, subject to RLS) ───────────────────
# Local dev + tests run on Dockerized Postgres (pnpm db:up). Production = Neon
# (ADR-022). The host is just a connection string (ADR-004 keeps us portable).
#   Local:  postgres://spillway_app:spillway@localhost:5432/spillway_dev
#   Neon:   postgres://<role>:<pw>@<ep>.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://spillway_app:spillway@localhost:5432/spillway_dev

# ─── Database (jobs role — BYPASSRLS-free; broader SELECT/DELETE grants only) ─
# Separate role is REQUIRED. Do not reuse DATABASE_URL here.
DATABASE_URL_JOBS=postgres://spillway_jobs:spillway_jobs@localhost:5432/spillway_dev

# Superuser URL for migrations only (GRANT + RLS need owner/superuser privileges).
# optional — falls back to DATABASE_URL. Local: use the 'spillway' superuser.
MIGRATION_DATABASE_URL=postgres://spillway:spillway@localhost:5432/spillway_dev

# Maximum connections for the app DB pool. optional; default 15
DB_POOL_MAX=15

# ─── Auth — WorkOS AuthKit (ADR-023) ───────────────────────────────────────
# Dashboard humans authenticate via WorkOS AuthKit; the server verifies the
# session JWT via WorkOS JWKS (RS256). SAML/SCIM are native upgrades (no migration).
# Get these from the WorkOS dashboard → "Copy environment variables" box.
# WORKOS_API_KEY is SECRET (sk_…); WORKOS_CLIENT_ID is public.
# Optional in dev/test (no auth runs until M1); REQUIRED in production.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
# Optional only when using a custom AuthKit domain. Default: https://api.workos.com/
# WORKOS_JWT_ISSUER=https://auth.yourdomain.com/
# Opt-in JWT audience enforcement (red-team): set to the WorkOS client id once the dashboard confirms
# the token carries a stable `aud`; then every token missing/mismatching it 401s. Omit to opt out
# (an EMPTY value is REJECTED at boot — it must not silently disable enforcement). Make it required
# in prod at M4 once the issuer is confirmed against a live token.
# WORKOS_JWT_AUD=client_...

# ─── Local auth dev story (13-build-order §M0.5) ───────────────────────────
# Two modes, both supported:
#  (a) Real WorkOS auth — set WORKOS_API_KEY + WORKOS_CLIENT_ID above (use the
#      WorkOS *Staging* environment's test keys for local development).
#  (b) Integration tests mint their own JWTs via
#      packages/shared/src/test-utils/mint-jwt.ts — NO running auth provider
#      needed. (M1 aligns mint-jwt to WorkOS RS256/JWKS; until then it mints
#      HS256 tokens for the verification stub.)

# ─── Encryption ────────────────────────────────────────────────────────────
# 32-byte AES-256-GCM master key for provider-key encryption (ADR-014), base64.
# Generate: openssl rand -base64 32
SPILLWAY_ENC_KEY_V1=

# ─── Approval action links ─────────────────────────────────────────────────
# HMAC secret for one-click approve/deny links (ADR-019i). 64 lowercase hex chars.
# Generate: openssl rand -hex 32
# REQUIRED in prod; optional in dev.
SPILLWAY_ACTION_TOKEN_SECRET=

# ─── Alert delivery ────────────────────────────────────────────────────────
# optional  — alert-delivery job silently skips Slack if absent
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# REQUIRED to enable the shared Slack sink: the ONLY org whose alerts it delivers (fail-closed —
# a shared webhook must not receive multiple tenants' alerts). Unset → shared sink delivers nothing.
ALERT_OPERATOR_ORG_ID=
# optional  — alert-delivery job silently skips email if absent
RESEND_API_KEY=re_...
# optional  — required in prod if RESEND_API_KEY is set; skipped in dev if absent
ALERT_FROM_EMAIL=alerts@yourdomain.com

# ─── Domain / CORS ─────────────────────────────────────────────────────────
# The canonical public origin. local default is http://localhost:3000
PUBLIC_URL=http://localhost:3000
# The dashboard SPA origin (control-plane CORS allow-list). Required in prod;
# optional in dev (defaults to deny-all cross-origin, safe behind a proxy).
DASHBOARD_ORIGIN=https://app.spillway.dev

# ─── Observability / metrics ────────────────────────────────────────────────
# Bearer token protecting GET /metrics. optional in dev; REQUIRED in prod.
METRICS_TOKEN=

# ─── Backup ────────────────────────────────────────────────────────────────
# optional; only needed when running tools/backup/backup-weekly.sh
BACKUP_S3_BUCKET=

# ─── Provider API keys (fixture recording / local smoke tests only) ────────
# NOT required to run the server. optional
FIXTURE_OPENAI_API_KEY=sk-...
FIXTURE_ANTHROPIC_API_KEY=sk-ant-...
FIXTURE_GEMINI_API_KEY=AIza...

# ─── Test infra ────────────────────────────────────────────────────────────
# Enables the test seeder endpoint. NEVER set in production.
# ENABLE_TEST_SEEDER=true  ← NEVER uncomment for production
